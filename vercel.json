{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/admin.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/printing",
      "destination": "/printing.html"
    },
    {
      "source": "/printing-admin",
      "destination": "/printing-admin.html"
    }
  ]
}
